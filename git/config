# ╭─────────────────────╮
# │ Shared Git defaults │
# ╰─═══════════════════─╯
# Keep identities outside this shared configuration so consuming machines can
# provide their own personal and work accounts without tracking them here.
[include]
	path = ~/.gitconfig-local

[pull]
	rebase = true

[init]
	defaultBranch = main

[core]
	hooksPath = ~/.config/git/hooks

# Preserve the existing GitLab identity override as machine-local state.
[includeIf "gitdir:~/Projects/GitLab/"]
	path = ~/.gitconfig-gitlab
