{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    // OpenCode keeps the OAuth credential under this native provider ID.
    "openai",
    "ollama"
  ],
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/Users/cbrst/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  },
  "provider": {
    "openai": {
      // Send native OpenAI requests through Headroom while preserving OAuth auth.
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "whitelist": [
        "qwen3:4b"
      ],
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3:4b": {
          "name": "Qwen3 4B \u2014 local helper"
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-terra"
    },
    "plan": {
      "model": "openai/gpt-5.6-luna"
    },
    "local-quick": {
      "mode": "primary",
      "description": "Fast local explanations, summaries, and small code suggestions",
      "model": "ollama/qwen3:4b",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  }
}
