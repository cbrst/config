// ╭─────────────────────────────────────────────────────────────────╮
// │ Niri manages windows while Noctalia provides the desktop shell. │
// ╰─═══════════════════════════════════════════════════════════════─╯

// ╭─────────────╮
// │ Environment │
// ╰─═══════════─╯
// Keep applications on their Wayland backends while preserving XWayland compatibility.
environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    GDK_BACKEND "wayland,x11,*"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "gtk3"
    SDL_VIDEODRIVER "wayland"
    MOZ_ENABLE_WAYLAND "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // Make the 1Password SSH agent available to graphical applications.
    SSH_AUTH_SOCK "$HOME/.1password/agent.sock"
    // Use the same cursor theme configured for GTK and XWayland by Home Manager.
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    // Java AWT needs this hint under a non-reparenting Wayland compositor.
    _JAVA_AWT_WM_NONREPARENTING "1"
}

// ╭───────╮
// │ Input │
// ╰─═════─╯
input {
    keyboard {
        // Make the shared US layout explicit rather than inheriting host defaults.
        xkb {
            layout "us"
        }
    }

    touchpad {
        // Sensible laptop defaults without imposing a device-specific acceleration profile.
        tap
        natural-scroll
        drag-lock
    }

    // Focus the output under the pointer without warping it during keyboard navigation.
    focus-follows-mouse max-scroll-amount="0%"
}

// ╭────────╮
// │ Layout │
// ╰─══════─╯
layout {
    always-center-single-column
    gaps 12
    center-focused-column "on-overflow"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        off
        width 2
        active-gradient from="#cba6f7" to="#89b4fa" angle=45
        inactive-color "#45475a"
    }

    border {
        on
        width 2
        active-gradient from="#cba6f7" to="#89b4fa" angle=45
        inactive-color "#45475a"
    }

    shadow {
        // Niri knows window geometry from the rule below, avoiding CSD shadow artifacts.
        on
        softness 24
        spread 3
        offset x=0 y=4
        color "#00000080"
    }

    tab-indicator {
        width 8
        gap 2
        corner-radius 4
        length total-proportion=0.8
        place-within-column
        position "left"
        active-gradient from="#cba6f7" to="#89b4fa" angle=45
    }
}

// Let applications omit client-side decorations so Niri can render clean rounded geometry.
prefer-no-csd

// ╭─────────╮
// │ Startup │
// ╰─═══════─╯
// Noctalia is the only shell process launched by the compositor.
spawn-at-startup "noctalia"

// ╭─────────────╮
// │ Screenshots │
// ╰─═══════════─╯
// Use timestamped names so compositor screenshots never overwrite one another.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ╭────────────╮
// │ Animations │
// ╰─══════════─╯
animations {
    // A modest speed-up preserves feedback without making workspace movement sluggish.
    slowdown 0.8
}

// ╭──────────────────╮
// │ Named Workspaces │
// ╰─════════════════─╯

workspace "Games" {
    layout {
        gaps 0

        struts {
            top 0
            right 0
            bottom 0
            left 0
        }

        border {
            off
        }
    }
}

// ╭──────────────╮
// │ Window Rules │
// ╰─════════════─╯

window-rule {
    // Rounded geometry also clips the content and makes the compositor shadow accurate.
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    // Keep common utility dialogs out of the scrolling tiled layout.
    match app-id=r#"^(pavucontrol|blueman-manager|nm-connection-editor)$"#
    open-floating true
}

window-rule {
    // Keep Firefox readable by opening its tiled column at four fifths of the output.
    match app-id="firefox"
    default-column-width { proportion 0.8; }
}

window-rule {
    match app-id="steam"
    open-on-workspace "Games"
    default-column-width { proportion 1.0; }
}

// ╭─────────────╮
// │ Layer Rules │
// ╰─═══════════─╯

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        // Blur Noctalia panels and overlays while retaining their theme's glass transparency.
        blur true
        xray false
        noise 0.015
        saturation 1.1
    }
    popups {
        // Apply the same readable glass treatment to menus opened from the shell.
        background-effect {
            blur true
            xray false
            noise 0.015
            saturation 1.1
        }
    }
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// ╭──────────╮
// │ Bindings │
// ╰─════════─╯

binds {
    // Launchers
    Mod+Return { spawn "ghostty"; }
    Mod+B { spawn "firefox-session"; }
    Mod+E { spawn "nemo"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+C { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+L { spawn "noctalia" "msg" "session" "lock"; }

    // Window management
    // Use both arrows and home-row keys for directional focus and column movement.
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Alt+Left { move-column-left; }
    Mod+Alt+Down { move-window-down; }
    Mod+Alt+Up { move-window-up; }
    Mod+Alt+Right { move-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Alt+H { move-column-left; }
    Mod+Alt+J { move-window-down; }
    Mod+Alt+K { move-window-up; }
    Mod+Alt+L { move-column-right; }

    // Fullscreen and maximize
    Mod+Shift+F { fullscreen-window; }
    Mod+F { maximize-column; }

    // Resize the focused column or window by one tenth of the output.
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Stack the adjacent window below the focused one, or return it to a column.
    // Mod+Comma { consume-window-into-column; }
    // Mod+Period { expel-window-from-column; }
    Mod+Comma { consume-or-expel-window-left; }
    Mod+Period { consume-or-expel-window-right; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+Alt+1 { move-column-to-workspace 1; }
    Mod+Alt+2 { move-column-to-workspace 2; }
    Mod+Alt+3 { move-column-to-workspace 3; }
    Mod+Alt+4 { move-column-to-workspace 4; }
    Mod+Alt+5 { move-column-to-workspace 5; }
    Mod+Alt+6 { move-column-to-workspace 6; }
    Mod+Alt+7 { move-column-to-workspace 7; }
    Mod+Alt+8 { move-column-to-workspace 8; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // Touchpads have "natural" scrolling, so these are reversed
    Mod+TouchpadScrollDown { focus-workspace-up; }
    Mod+TouchpadScrollUp { focus-workspace-down; }

    // ╭───────╮
    // │ Media │
    // ╰─═════─╯

    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.5" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // ╭──────────────╮
    // │ WM Functions │
    // ╰─════════════─╯

    Mod+Q repeat=false { close-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+O { toggle-overview; }
    Mod+T { toggle-column-tabbed-display; }
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+E { quit; }
}

// ╭─────────────────╮
// │ Startup Overlay │
// ╰─═══════════════─╯
// Suppress the default hotkey reference after each compositor launch.

hotkey-overlay {
    skip-at-startup
}
