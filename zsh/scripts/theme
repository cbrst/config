#!/bin/sh
# Select a theme family without modifying Home Manager-managed configuration.

set -eu

state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
state_dir="$state_home/config-theme"
state_file="$state_dir/family"

if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  family=select
else
  family=${1:-status}
fi

case "$family" in
  select)
    # fzf is optional so the selector remains usable outside the managed profile.
    if command -v fzf >/dev/null 2>&1; then
      family=$(printf '%s\n' meowsoot monokai-pro | fzf --prompt='Theme> ') || exit 0
    else
      printf '%s\n' 'Select a theme family:' '1) meowsoot' '2) monokai-pro' >&2
      printf '%s' 'Choice [1-2]: ' >&2
      IFS= read -r selection || exit 1
      case "$selection" in
        1|meowsoot) family=meowsoot ;;
        2|monokai-pro) family=monokai-pro ;;
        *)
          printf '%s\n' 'No theme selected.' >&2
          exit 64
          ;;
      esac
    fi
    ;;
esac

case "$family" in
  meowsoot)
    ghostty_theme='light:meowsoot-dawn,dark:meowsoot'
    ;;
  monokai-pro)
    ghostty_theme='light:monokai-pro-light,dark:monokai-pro-spectrum'
    ;;
  status)
    if [ -r "$state_file" ]; then
      IFS= read -r selected < "$state_file" || selected=meowsoot
    else
      selected=meowsoot
    fi
    case "$selected" in
      meowsoot|monokai-pro) ;;
      *) selected=meowsoot ;;
    esac
    printf '%s\n' "$selected"
    exit 0
    ;;
  *)
    printf '%s\n' 'Usage: theme [meowsoot|monokai-pro|select|status]' >&2
    exit 64
    ;;
esac

firefox_theme="$config_home/config-theme/firefox/$family.css"
if [ ! -r "$firefox_theme" ]; then
  printf '%s\n' "Theme assets are unavailable: $firefox_theme" >&2
  printf '%s\n' 'Apply the Home Manager configuration before selecting a theme.' >&2
  exit 1
fi

umask 077
mkdir -p "$state_dir" "$config_home/ghostty"
printf '%s\n' "$family" > "$state_file"

# Ghostty loads this optional file after the shared default configuration.
printf '%s\n' "theme = $ghostty_theme" > "$config_home/ghostty/theme"

# Firefox imports this runtime copy while Tridactyl sources its runtime directive.
cp "$firefox_theme" "$state_dir/firefox-wayland.css"
printf '%s\n' '" Generated by theme; changes are overwritten.' "colorscheme $family" \
  > "$state_dir/tridactylrc"

printf 'Selected %s. New Neovim and OpenCode sessions use it immediately; reload Ghostty and restart Firefox to apply it.\n' "$family"
